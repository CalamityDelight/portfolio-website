# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres connection strings. `neon deploy` / `neon env pull` fill these in.
# Pooled (host ends in -pooler): used by the app
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
# Direct: used by `npm run db:setup` for schema changes
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign the login session cookie
SESSION_SECRET=replace-with-a-long-random-string

# Cloudinary, for video and image uploads: Settings -> API Keys in the Cloudinary console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Anthropic API key for the AI summary: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-replace-me
# Optional: which Claude model writes the summary (default claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: port for the local server
PORT=3000
