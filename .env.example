# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres connection strings. `neon deploy` / `neon env pull` fill these in.
# Pooled (host ends in -pooler): used by the app
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
# Direct: used by `npm run db:setup` for schema changes
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign the login session cookie
SESSION_SECRET=replace-with-a-long-random-string

# Cloudinary API environment variable, from the Cloudinary dashboard
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# OpenRouter API key for the AI summary
OPENROUTER_API_KEY=sk-or-replace-me
# Optional: which model writes the summary (default anthropic/claude-sonnet-5.5)
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Optional: port for the local server
PORT=3000
