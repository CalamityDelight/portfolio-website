# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres connection string (Part 2)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign the login session cookie (Part 2)
SESSION_SECRET=replace-with-a-long-random-string

# Cloudinary API environment variable, from the Cloudinary dashboard (Part 2)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# OpenRouter API key for the AI summary (Part 3)
OPENROUTER_API_KEY=sk-or-replace-me

# Optional: port for the local server
PORT=3000
